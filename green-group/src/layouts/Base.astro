---
import Navbar from "../components/Navbar.svelte";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Personal site of Faidra Antoniadou" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Didact+Gothic&family=Inter:opsz,wght@14..32,100..900&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <Navbar client:load currentPath={currentPath} />

    <main class="mx-auto max-w-5xl px-6 py-16">
      <slot />
    </main>

    <footer class="mx-auto max-w-5xl border-t border-border/60 px-6 py-8 text-sm text-muted-foreground">
      © {new Date().getFullYear()} Faidra Antoniadou
    </footer>
  </body>
</html>