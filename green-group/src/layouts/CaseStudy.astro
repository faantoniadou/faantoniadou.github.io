---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import { Icon } from "astro-icon/components";
interface Props {
  entry: CollectionEntry<"case-studies">;
}
const { entry } = Astro.props;
const { title, blurb, role, org, year, cover, coverAlt, tags, draft, accent } = entry.data;
---

<Base title={`${title} | Faidra Antoniadou`} description={blurb}>
  <article style={accent ? `--link:${accent}` : undefined}>
    <a href="/#selected-work" class="link text-sm text-muted-foreground hover:text-link"> 
      <div class="inline-flex items-center gap-1">
        <Icon name="lucide:arrow-left" />
        All projects
      </div>
    </a>

    <header class="mt-10 max-w-3xl">
      <h3 class="font-display text-4xl leading-[0.95]">{title}</h3>
      <p class="mt-4 text-xl text-muted-foreground">{blurb}</p>

      <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-3 text-sm">
        {role && <div><dt class="text-muted-foreground">Role</dt><dd>{role}</dd></div>}
        {org && <div><dt class="text-muted-foreground">With</dt><dd>{org}</dd></div>}
        <div><dt class="text-muted-foreground">Year</dt><dd>{year}</dd></div>
      </dl>
    </header>

    <Image src={cover} alt={coverAlt} class="my-12 w-full" />

    <div class="essay prose prose-lg max-w-none prose-headings:font-display prose-headings:font-normal prose-headings:text-foreground prose-p:text-foreground/85 prose-strong:text-foreground prose-a:text-link">
      <slot />
    </div>
  </article>
</Base>

<style>
  /* text sits in a narrow centre column; .wide elements break out to the full width */
  .essay {
    display: grid;
    grid-template-columns:
      [wide-start] minmax(0, 1fr)
      [content-start] minmax(0, 42rem)
      [content-end] minmax(0, 1fr)
      [wide-end];
  }
  .essay > :global(*) { grid-column: content; }
  .essay > :global(.wide) { grid-column: wide; }
</style>