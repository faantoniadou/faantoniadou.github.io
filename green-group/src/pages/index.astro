---
import BaseHead from '../components/BaseHead.astro';
import Base from '../layouts/Base.astro';
import { Icon } from "astro-icon/components";

import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { SOCIALS } from '../consts';
import '../styles/global.css';

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Base title="About | Faidra Antoniadou">
		<section class="flex min-h-[20vh] flex-col gap-8 md:flex-row md:items-center md:gap-14">

			<!-- Social icons: a column on the left (a row above the text on mobile) -->
			<ul class="flex gap-8 md:flex-col">
				{SOCIALS.map((s, i) => (
					<li class="reveal" style={`--i:${i + 1}`}>
						<a
							href={s.href}
							aria-label={s.label}
							class="block text-muted-foreground transition-all duration-200 hover:-translate-y-0.5 hover:text-link"
						>
							<Icon name={s.icon} class="h-5 w-5" />
						</a>
					</li>
				))}
			</ul>

			<div class="flex flex-col gap-6">
				<h1 
					class="reveal font-display text-[clamp(3rem,4vw,9rem)] leading-[0.95]"
					style="--i:0"
				>
					Faidra Antoniadou
				</h1>
				<p class="reveal max-w-md text-2xl text-muted-foreground mb-10" style="--i:1">
					I design and build products that put people first.
				</p>
				<a
					href="/work"
					class="reveal group inline-flex w-fit items-center gap-3 border border-link px-6 py-3 font-display text-xl transition-colors duration-300 hover:bg-link hover:text-background"
					style="--i:2"
				>
					See my work
					<span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">
						<Icon name="lucide:arrow-right" class="h-5 w-5" />
					</span>
				</a>
			</div>
		</section>
		</Base>
	</body>
</html>
