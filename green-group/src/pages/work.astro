---
import Base from "../pages/../layouts/Base.astro";
import CVButton from "../components/CVButton.astro";
import Experience from "../components/Experience.astro";
import Community from "../components/Community.astro";
import Education from "../components/Education.astro";
import SectionNav from "../components/SectionNav.svelte";

import { getCollection } from "astro:content";
---

<Base title="Work | Faidra Antoniadou">
	<header class="flex flex-col gap-5">
		<h1 class="reveal font-display text-5xl" style="--i:0">Work</h1>

		<p class="reveal max-w-md text-muted-foreground" style="--i:1">
			Where I've worked, what I've built, and the community work I do alongside it.
		</p>

		<div class="reveal" style="--i:2">
			<CVButton class="justify-center" />
		</div>
	</header>

	<div class="sticky top-20 z-40 mt-10 flex">
		<SectionNav
			client:load
			sections={[
				{ id: "experience", label: "Experience" },
				{ id: "community", label: "Community" },
				{ id: "education", label: "Education" },
			]}
		/>
	</div>

  <!-- <section id="case-studies" class="mt-10 scroll-mt-24"> -->
    <!-- <h2 class="font-display text-3xl">Case studies</h2> -->
    <!-- <ul class="mt-8 grid gap-10 md:grid-cols-2"> -->
      <!-- {projects.map((p) => (
        <li>
          <a href={`/work/${p.id}`} class="group block">
            <img src={p.data.cover} alt="" class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:-translate-y-1" />
            <h3 class="mt-4 font-display text-2xl">{p.data.title}</h3>
            <p class="text-muted-foreground">{p.data.blurb}</p>
          </a>
        </li>
      ))} -->
    <!-- </ul> -->
  <!-- </section> -->

  <Experience />
	<Community />
	<Education />
</Base>
