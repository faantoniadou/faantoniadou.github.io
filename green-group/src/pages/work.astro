---
import Base from "../pages/../layouts/Base.astro";
import { getCollection } from "astro:content";

// const projects = await getCollection("work");

const highlights = [
  {
    stat: "Now",
    label: "Leading discovery",
    detail: "Leading discovery for an internal automation: running user interviews to understand the Compliance team's main pain points before deciding what to build.",
    tags: ["User interviews", "Data analysis", "Synthesis"],
  },
  {
    stat: "2×",
    label: "frontend output",
    detail: "Built two AI agent skills: one encoding Cisco's internal component library, one automatically checking rendered UI. IT leadership called it “setting a great example for the entire IT organisation.”",
    tags: ["AI agents", "Playwright MCP", "Design systems"],
  },
  {
    stat: "−92%",
    label: "slow queries",
    detail: "Cut slow database queries from 63K to 5K a week on the hybrid-work platform by diagnosing high-latency aggregations.",
    tags: ["MongoDB", "Performance"],
  },
  {
    stat: "−60%",
    label: "worst-case load time",
    detail: "From 6s to 2s, so the platform feels faster for the people using it.",
    tags: ["Performance", "Full-stack"],
  },
  {
    stat: "2",
    label: "hiring cycles",
    detail: "Supported early-careers hiring through CV screening and first-round interviews, recognised for sincerity and engagement.",
    tags: ["Mentoring", "Hiring"],
  },
];

const experience = [
  {
    role: "Software Engineer",
    company: "Cisco",
    dates: "2025 – Present", // your real dates
    themes: [
      {
        label: "Understanding people",
        points: [
          {
            lead: "Leading discovery for an internal automation.",
            detail: "Interviewing the people who do this work today and analysing usage data, so we understand the problem before deciding what to build.",
          },
        ],
      },
      {
        label: "Bridging design and engineering",
        points: [
          {
            lead: "Built AI agent skills that keep the UI faithful to the design system.",
            detail: "One encodes Cisco's internal component library; the other checks rendered UI with Chrome DevTools and Playwright MCP. It doubled frontend output, and IT leadership called the demo “setting a great example for the entire IT organisation.”",
          },
          {
            lead: "Made the hybrid-work platform faster for everyone using it.",
            detail: "Traced slow loads to high-latency MongoDB aggregations and shipped the most efficient fix, taking worst-case load times from 6s to 2s.",
          },
        ],
      },
      {
        label: "Supporting people",
        points: [
          {
            lead: "Helped welcome the next generation of engineers.",
            detail: "Supported two early-careers hiring cycles through CV screening and first-round interviews, and was recognised for sincerity, proactiveness and engagement.",
          },
        ],
      },
    ],
  },
];
---

<Base title="Work | Faidra Antoniadou">
  <h1 class="reveal font-display text-5xl" style="--i:0">Work</h1>

  <nav class="reveal mt-6 flex flex-wrap gap-6 text-muted-foreground" style="--i:1">
    <a href="#case-studies" class="link-underline">Case studies</a>
    <a href="#experience" class="link-underline">Experience</a>
    <a href="/cv.pdf" download class="link-underline">Download CV</a>
  </nav>

  <section id="case-studies" class="mt-20 scroll-mt-24">
    <h2 class="font-display text-3xl">Case studies</h2>
    <ul class="mt-8 grid gap-10 md:grid-cols-2">
      <!-- {projects.map((p) => (
        <li>
          <a href={`/work/${p.id}`} class="group block">
            <img src={p.data.cover} alt="" class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:-translate-y-1" />
            <h3 class="mt-4 font-display text-2xl">{p.data.title}</h3>
            <p class="text-muted-foreground">{p.data.blurb}</p>
          </a>
        </li>
      ))} -->
    </ul>
  </section>

  <section id="experience" class="mt-24 scroll-mt-24">
		<h2 class="font-display text-3xl">Experience</h2>

		<!-- PART A: timeline -->
		<ol class="mt-10 border-l border-border pl-8 md:pl-12">
			{experience.map((job) => (
				<li class="scroll-reveal relative pb-16">
					<span class="absolute -left-8 top-2 h-3 w-3 -translate-x-1/2 rounded-full bg-link md:-left-12"></span>

					<p class="text-sm text-muted-foreground">{job.dates}</p>
					<h3 class="font-display text-3xl">{job.role}</h3>
					<p class="text-lg text-muted-foreground">{job.company}</p>

					<div class="mt-10 space-y-12">
						{job.themes.map((theme) => (
							<div>
								<p class="font-display text-sm uppercase tracking-widest text-link">{theme.label}</p>

								<ul class="mt-4 space-y-6">
									{theme.points.map((p) => (
										<li class="group relative pl-8 before:absolute before:left-0 before:top-[0.8em] before:h-px before:w-4 before:bg-link before:transition-all before:duration-300 group-hover:before:w-6">
											<p class="font-display text-xl leading-snug">{p.lead}</p>
											<p class="mt-1 max-w-prose text-muted-foreground">{p.detail}</p>
										</li>
									))}
								</ul>
							</div>
						))}
					</div>

					<p class="mt-12 max-w-prose text-sm text-muted-foreground">{job.also}</p>
				</li>
			))}
		</ol>
	</section>
</Base>