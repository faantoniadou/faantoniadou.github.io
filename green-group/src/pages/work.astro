---

<Base title="Work | Faidra Antoniadou">
  <h1 class="reveal font-display text-5xl" style="--i:0">Work</h1>

  <nav class="reveal mt-6 flex flex-wrap gap-6 text-muted-foreground" style="--i:1">
    <!-- <a href="#case-studies" class="link-underline">Case studies</a> -->
    <a href="#experience" class="link-underline">Experience</a>
		<a href="#community" class="link-underline">Community</a>
		<a href="#education" class="link-underline">Education</a>
    <a href="/assets/cv.pdf" download class="link-underline">Download CV</a>
  </nav>

  <!-- <section id="case-studies" class="mt-10 scroll-mt-24"> -->
    <!-- <h2 class="font-display text-3xl">Case studies</h2> -->
    <!-- <ul class="mt-8 grid gap-10 md:grid-cols-2"> -->
      <!-- {projects.map((p) => (
        <li>
          <a href={`/work/${p.id}`} class="group block">
            <img src={p.data.cover} alt="" class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:-translate-y-1" />
            <h3 class="mt-4 font-display text-2xl">{p.data.title}</h3>
            <p class="text-muted-foreground">{p.data.blurb}</p>
          </a>
        </li>
      ))} -->
    <!-- </ul> -->
  <!-- </section> -->

  <section id="experience" class="mt-10 scroll-mt-24">
		<h2 class="font-display text-3xl">Experience</h2>

		<!-- PART A: timeline -->
		<ol class="mt-10 border-l border-border pl-8 md:pl-12">
			{experience.map((job) => (
				<li class="scroll-reveal relative pb-12">
					<span class="absolute -left-8 top-2 h-3 w-3 -translate-x-1/2 rounded-full bg-link md:-left-12"></span>

					<p class="text-sm text-muted-foreground">{job.dates}</p>
					<h3 class="font-display text-2xl">{job.role}</h3>
					<p class="text-md text-muted-foreground">{job.company}</p>

					<div class="mt-10 space-y-12">
						{job.themes.map((theme) => (
							<div>
								<p class="font-display text-xs uppercase tracking-widest text-link">{theme.label}</p>

								<ul class="mt-4 space-y-6">
									{theme.points.map((p) => (
										<li class="group/point relative pl-8 before:absolute before:left-0 before:top-[0.8em] before:h-px before:w-4 before:bg-link before:transition-all before:duration-300 group-hover:before:w-6">
											<p class="font-display text-lg leading-snug">{p.lead}</p>
											<p class="mt-1 max-w-prose text-muted-foreground">{p.detail}</p>
											{p.tags && (
												<ul class="mt-3 flex flex-wrap gap-2" aria-label="Skills and tools">
													{p.tags.map((tag) => (
														<li>
															{/* make hover colour a bit transparent */}
															<Badge variant="outline" class="tag font-normal text-muted-foreground transition-colors duration-300 group-hover/point:border-link/50 group-hover/point:text-foreground">
																{tag}
															</Badge>
														</li>
													))}
												</ul>
											)}
										</li>
									))}
								</ul>
							</div>
						))}
					</div>

					<p class="mt-6 mb-6 max-w-prose text-sm text-muted-foreground">{job.also}</p>
				</li>
			))}
			<details class="mt-16">
					<summary class="cursor-pointer font-display text-xl">Earlier experience</summary>
					<ul class="mt-8 space-y-6">
						{earlier.map((e) => (
							<li class="grid gap-1 md:grid-cols-[10rem_1fr] md:gap-10">
								<p class="text-sm text-muted-foreground">{e.dates}</p>
								<div>
									<p class="font-display text-lg">{e.role}, {e.org}</p>
									<p class="text-muted-foreground">{e.line}</p>
								</div>
							</li>
						))}
					</ul>
				</details>
		</ol>
	</section>
	<section id="community" class="mt-24 scroll-mt-24">
		<h2 class="font-display text-3xl">Community</h2>
		<p class="mt-3 max-w-prose text-muted-foreground">
			Time well spent, supporting the community and helping others to learn and grow.
		</p>
	
		<ol class="mt-10 space-y-14">
			{community.map((item) => (
				<li class="scroll-reveal relative pb-12">
	
					<div>
						<p class="text-sm text-muted-foreground">{item.dates}</p>
						<h3 class="font-display text-2xl leading-snug">{item.role}</h3>
						<p class="text-muted-foreground">{item.org}</p>
	
						<ul class="mt-4 space-y-3">
							{item.points.map((point) => (
								<li class="relative max-w-prose text-light pl-8 before:absolute before:left-0 before:top-[0.8em] before:h-px before:w-4 before:bg-link">
									<p class="font-display text-lg leading-snug">{point}</p>
								</li>
							))}
						</ul>
					</div>
				</li>
			))}
		</ol>
	</section>
	<section id="education" class="mt-24 scroll-mt-24">
			<h2 class="font-display text-3xl">Education</h2>
		
			<ol class="mt-10 space-y-4">
				{education.map((item) => (
					<li class="scroll-reveal relative pb-12">
		
						<div>
							<p class="text-sm text-muted-foreground">{item.dates}</p>
							<h3 class="font-display text-2xl leading-snug">{item.school}</h3>
							<p class="text-muted-foreground">{item.degree}</p>
							<p class="font-display text-lg leading-snug">{item.note}</p>
						</div>
					</li>
				))}
			</ol>
		</section>
	
</Base>