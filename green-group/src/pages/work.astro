---
import Base from "../pages/../layouts/Base.astro";
import CVButton from "../components/CVButton.astro";
import WorkExperience from "@/components/WorkExperience.astro";
import EarlyExperience from "../components/EarlyExperience.astro";

import { getCollection } from "astro:content";

// const projects = await getCollection("work");

const community = [
	{
		role: "Outreach Team Member, Feltham",
		org: "Cisco",
		dates: "Aug 2025 – Present",
		points: [
			"Speak on panels and run a workshop for university and school students to understand how to get into tech, and what it's like to work in the industry.",
			"Gave constructive feedback and career advice in two speed-interviewing sessions for high school students, helping them prepare for their first interviews.",
		],
	},
	{
		role: "Charity Lead",   // confirm the wording you'd use for your role
		org: "Cisco | Oxfordshire Mind",
		dates: "Jan 2026 - Nov 2026",
		points: [
			"Led a year-long campaign that raised just short of £7,000, persuading 10 colleagues to run a half marathon together.",
			"Acted as the link between our team and the charity: advised on how best to tell their story, volunteered with them, and hosted them at our office for a lunch and learn that boosted donations.",
			"Promoted the campaign through company channels, newsletter articles and org-wide meeting announcements, and booked a photographer for race day to share the results afterwards.",
		],
	},	
	{
		role: "Physics Outreach Team, Senior Member",
		org: "University of Edinburgh",
		dates: "Sep 2018 – May 2022",
		points: [
			"Mentored teams to design and deliver workshops in underprivileged schools, working with the Science and Technology Facilities Council.",
			"Helped develop content for the Online Sutton Trust Summer School 2020 and produced an introduction video for its Physics course, later used by the School of Physics and Astronomy for promotion.",
			"Attained the Edinburgh Award for self-development.",
		],
	},
];

const earlier = [
	{ role: "Operations Intern", org: "Amazon", dates: "Jun – Aug 2021",
		line: "Automated a manual process with a tool built in Excel (VBA, JavaScript), trialling it with users and iterating on their feedback until 80% found it beneficial." },
	{ role: "Systems Engineering Intern", org: "Leonardo", dates: "May – Aug 2022",
		line: "Turned stakeholder needs into a requirements document and built a MATLAB tool to analyse radar performance." },
];

const education = [
	{
		degree: "MSc Computer Science",
		school: "UCL",
		dates: "2022-2023",
		note: "Distinction, IBM Quantum Computing Project",
	},
	{
		degree: "BSc (Hons) Computational Physics",
		school: "University of Edinburgh",
		dates: "2018-2022",
		note: "First Class Honours, Margaret Campbell Scott Scholarship",
	},
];
---

<Base title="Work | Faidra Antoniadou">
  <h1 class="reveal font-display text-5xl" style="--i:0">Work</h1>

	<div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
		<nav class="reveal mt-6 flex flex-wrap gap-6 text-muted-foreground" style="--i:1">
			<!-- <a href="#case-studies" class="link-underline">Case studies</a> -->
			<a href="#experience" class="link-underline">Experience</a>
			<a href="#community" class="link-underline">Community</a>
			<a href="#education" class="link-underline">Education</a>
		</nav>
		<!-- CV button component imported -->
		<div class="reveal mt-2" style="--i:2">
			<CVButton />
		</div>	
	</div>
  <!-- <section id="case-studies" class="mt-10 scroll-mt-24"> -->
    <!-- <h2 class="font-display text-3xl">Case studies</h2> -->
    <!-- <ul class="mt-8 grid gap-10 md:grid-cols-2"> -->
      <!-- {projects.map((p) => (
        <li>
          <a href={`/work/${p.id}`} class="group block">
            <img src={p.data.cover} alt="" class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:-translate-y-1" />
            <h3 class="mt-4 font-display text-2xl">{p.data.title}</h3>
            <p class="text-muted-foreground">{p.data.blurb}</p>
          </a>
        </li>
      ))} -->
    <!-- </ul> -->
  <!-- </section> -->

  <section id="experience" class="mt-10 scroll-mt-24">
		<h2 class="font-display text-3xl">Experience</h2>

		<!-- PART A: timeline -->
		<ol class="mt-10 border-l border-border pl-8 md:pl-12">
			<WorkExperience />
			<EarlyExperience />
		</ol>
	</section>
	<section id="community" class="mt-24 scroll-mt-24">
		<h2 class="font-display text-3xl">Community</h2>
		<p class="mt-3 max-w-prose text-muted-foreground">
			Time well spent, supporting the community and helping others to learn and grow.
		</p>
	
		<ol class="mt-10 space-y-14">
			{community.map((item) => (
				<li class="scroll-reveal relative pb-12">
	
					<div>
						<p class="text-sm text-muted-foreground">{item.dates}</p>
						<h3 class="font-display text-2xl leading-snug">{item.role}</h3>
						<p class="text-muted-foreground">{item.org}</p>
	
						<ul class="mt-4 space-y-3">
							{item.points.map((point) => (
								<li class="relative max-w-prose text-light pl-8 before:absolute before:left-0 before:top-[0.8em] before:h-px before:w-4 before:bg-link">
									<p class="font-display text-lg leading-snug">{point}</p>
								</li>
							))}
						</ul>
					</div>
				</li>
			))}
		</ol>
	</section>
	<section id="education" class="mt-24 scroll-mt-24">
			<h2 class="font-display text-3xl">Education</h2>
		
			<ol class="mt-10 space-y-4">
				{education.map((item) => (
					<li class="scroll-reveal relative pb-12">
		
						<div>
							<p class="text-sm text-muted-foreground">{item.dates}</p>
							<h3 class="font-display text-2xl leading-snug">{item.school}</h3>
							<p class="text-muted-foreground">{item.degree}</p>
							<p class="font-display text-lg leading-snug">{item.note}</p>
						</div>
					</li>
				))}
			</ol>
		</section>
	
</Base>