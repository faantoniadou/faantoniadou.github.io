---
import Base from "../pages/../layouts/Base.astro";
import CVButton from "../components/CVButton.astro";
import Professional from "../components/Professional.astro";
import Community from "../components/Community.astro";
import Education from "../components/Education.astro";
import SectionNav from "../components/SectionNav.svelte";
import { Icon } from "astro-icon/components";

import { getCollection } from "astro:content";
---

<Base title="Professional | Faidra Antoniadou">
	<a href="/" class="link text-sm text-muted-foreground hover:text-link"> 
		<div class="inline-flex items-center gap-1 mb-6">
			<Icon name="lucide:arrow-left" />
			Home
		</div>
	</a>

	<header class="flex ml-3 flex-col gap-5">
		<h1 class="reveal font-display text-5xl mb-12" style="--i:0">Professional</h1>
		<div class="reveal" style="--i:2">
			<CVButton class="justify-center" />
		</div>
	</header>

	<div class="sticky ml-2 top-20 z-40 mt-10 flex">
		<SectionNav
			client:load
			sections={[
				{ id: "", label: "Professional" },
				{ id: "community", label: "Community" },
				{ id: "education", label: "Education" },
			]}
		/>
	</div>

  <!-- <section id="case-studies" class="mt-10 scroll-mt-24"> -->
    <!-- <h2 class="font-display text-3xl">Case studies</h2> -->
    <!-- <ul class="mt-8 grid gap-10 md:grid-cols-2"> -->
      <!-- {projects.map((p) => (
        <li>
          <a href={`/work/${p.id}`} class="group block">
            <img src={p.data.cover} alt="" class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:-translate-y-1" />
            <h3 class="mt-4 font-display text-2xl">{p.data.title}</h3>
            <p class="text-muted-foreground">{p.data.blurb}</p>
          </a>
        </li>
      ))} -->
    <!-- </ul> -->
  <!-- </section> -->

  <Professional />
	<Community />
	<Education />
</Base>
<script>
	const tl = document.querySelector<HTMLElement>("[data-timeline]");

	if (tl && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const items = Array.from(tl.querySelectorAll<HTMLElement>(":scope > li"));
		const dots = Array.from(tl.querySelectorAll<HTMLElement>("[data-dot]"));
		let ticking = false;
		let lastY = scrollY;
		let settle: number;

		// vertical centre of an element, measured from the top of the timeline
		const centreY = (el: HTMLElement, top: number) => {
			const r = el.getBoundingClientRect();
			return r.top + r.height / 2 - top;
		};

		const update = () => {
			const speed = Math.min(Math.abs(scrollY - lastY) / 60, 1);
			lastY = scrollY;
			tl.style.setProperty("--stretch", String(speed * 0.6));
			clearTimeout(settle);
			settle = window.setTimeout(() => tl.style.setProperty("--stretch", "0"), 120);

			ticking = false;
			if (!dots.length) return;

			const focus = window.innerHeight * 0.5; // the middle of the screen
			const top = tl.getBoundingClientRect().top;

			const first = centreY(dots[0], top);
			const last = tl.getBoundingClientRect().height; // the very end of the line
			const y = Math.min(Math.max(focus - top, first), last);

			tl.style.setProperty("--start-y", `${first}px`);
			tl.style.setProperty("--bead-y", `${y}px`);
			tl.style.setProperty("--trail-h", `${y - first}px`);

			items.forEach((li) => {
				const dot = li.querySelector<HTMLElement>("[data-dot]");
				if (!dot) return;
				const distance = Math.abs(dot.getBoundingClientRect().top + dot.offsetHeight / 2 - focus);
				li.style.setProperty("--near", String(Math.max(0, 1 - distance / 140)));
			});
		};

		const schedule = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};

		addEventListener("scroll", schedule, { passive: true });
		addEventListener("resize", schedule);
		document.fonts?.ready.then(schedule); // heights shift once fonts load
		update();
	}
</script>