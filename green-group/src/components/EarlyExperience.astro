---
const earlier = [
  { role: "Operations Intern", org: "Amazon", dates: "Jun – Aug 2021",
    line: "Automated a manual process with a tool built in Excel (VBA, JavaScript), trialling it with users and iterating on their feedback until 80% found it beneficial." },
  { role: "Systems Engineering Intern", org: "Leonardo", dates: "May – Aug 2022",
    line: "Turned stakeholder needs into a requirements document and built a MATLAB tool to analyse radar performance." },
];
---
<details>
  <summary class="cursor-pointer font-display text-xl">Earlier experience</summary>
  <ul class="mt-8 space-y-6">
    {earlier.map((e) => (
      <li class="grid gap-1 md:grid-cols-[10rem_1fr] md:gap-10">
        <p class="text-sm text-muted-foreground">{e.dates}</p>
        <div>
          <p class="font-display text-lg">{e.role}, {e.org}</p>
          <p class="text-muted-foreground">{e.line}</p>
        </div>
      </li>
    ))}
  </ul>
</details>