---
interface Props {
  eyebrow?: string;
  title?: string;
  wide?: boolean;
  flip?: boolean; // put the image on the left instead of the right
}
const { eyebrow, title, wide = false, flip = false } = Astro.props;
const hasImage = Astro.slots.has("image");
---

<section
  class:list={[
    "my-5",
    (wide || hasImage) && "wide",
    hasImage && "md:grid md:grid-cols-2 md:items-center md:gap-12",
  ]}
>
  <div class:list={[hasImage && flip && "md:order-2"]}>
    {(eyebrow || title) && (
      <header class="not-prose mb-6">
        {eyebrow && (
          <p class="font-display text-xs uppercase tracking-[0.2em] text-link">{eyebrow}</p>
        )}
        {title && <h2 class="mt-2 font-display text-3xl leading-tight">{title}</h2>}
      </header>
    )}

    <div
      class="text-base font-light leading-relaxed text-foreground/90
             [&_p]:mb-5 [&_p:last-child]:mb-0"
    >
      <slot />
    </div>
  </div>

  {hasImage && (
    <div class:list={["mt-8 md:mt-0", flip && "md:order-1"]}>
      <slot name="image" />
    </div>
  )}
</section>