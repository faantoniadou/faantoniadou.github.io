---
interface Props {
  eyebrow?: string; // small heading above the main title
  title?: string;
  wide?: boolean;   // breaks out of the narrow text column
  split?: boolean;  // heading on the left, text on the right (desktop)
}
const { eyebrow, title, wide = false, split = false } = Astro.props;
---

<section
  class:list={[
    "my-8",
    wide && "wide",
    split && "md:grid md:grid-cols-[1fr_2fr] md:gap-12 font-display",
  ]}
>
  <header class="not-prose mb-6 md:mb-0">
    {eyebrow && (
      <p class="font-display text-xs uppercase tracking-[0.2em] text-link">{eyebrow}</p>
    )}
    <h2 class="mt-2 font-display text-3xl leading-tight sm:text-3xl">{title}</h2>
  </header>

  <div>
    <slot />
  </div>
</section>