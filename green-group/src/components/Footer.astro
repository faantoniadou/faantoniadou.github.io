---
import { Icon } from "astro-icon/components";
import { SOCIALS } from '../consts';

const today = new Date();
const iconSize = 24;
---

<footer
	class="mx-auto flex w-full max-w-5xl flex-col items-start gap-4 border-t border-border/60 px-6 py-8 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
>
	<p>&copy; {today.getFullYear()} Faidra Antoniadou. All rights reserved.</p>

	<div class="flex items-center gap-6">
		<a>
			{SOCIALS.map((s, i) => (
				<a
					href={s.href}
					aria-label={s.label}
					class="block text-muted-foreground hover:text-link"
				>
					<Icon name={s.icon} class="h-5 w-5" />
				</a>
			))}
		</a>
	</div>
</footer>