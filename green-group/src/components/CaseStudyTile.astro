---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"case-studies">;
}
const { entry } = Astro.props;
const { title, blurb, year, tags, accent, blobs, thumbnail, thumbnailAlt, cover, coverAlt } = entry.data;

const image = thumbnail ?? cover;
const alt = thumbnail ? (thumbnailAlt ?? "") : coverAlt;
const [c1, c2] = blobs ?? [
  accent ?? "var(--link)",
  `color-mix(in oklab, ${accent ?? "var(--link)"} 35%, white)`,
];
---

<a
  href={`/case-studies/${entry.id}`}
  class="group block rounded-[2.5rem] outline-offset-8 focus-visible:outline-2 focus-visible:outline-link"
  style={`--c1:${c1}; --c2:${c2}`}
>
  <!-- thumbnail with two glows behind it -->
  <div class="relative aspect-square w-full">
    <span class="blob blob-a" aria-hidden="true"></span>
    <span class="blob blob-b" aria-hidden="true"></span>

    <div class="relative size-full overflow-hidden rounded-[2.5rem] transition-all duration-500 group-active:-translate-y-2">
      {image ? (
        <Image
          src={image}
          alt={alt}
          class="scale-95 self-center size-full object-cover transition-transform duration-200 group-hover:scale-100 group-active:scale-100"
        />
      ) : (
        <div class="flex size-full flex-col justify-between bg-link/10 p-6">
          <p class="font-display text-xs uppercase tracking-[0.2em] text-link">{tags[0] ?? "Case study"}</p>
          <p class="font-display text-7xl leading-none text-link/60">{year}</p>
        </div>
      )}
    </div>
  </div>

  <!-- text -->
  <div class="mt-6 px-1">
    <h2 class="font-display text-2xl leading-tight">
      <span class="title-line">{title}</span>
    </h2>
    {blurb && <p class="mt-2 text-sm text-muted-foreground">{blurb}</p>}
  </div>
</a>

<style>
  .blob {
    position: absolute;
    width: 50%;
    aspect-ratio: 1;
    border-radius: 9999px;
    filter: blur(28px);
    opacity: 0;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.9s ease;
  }
  .blob-a { background: var(--c1); top: -4%; left: -5%; transform: translate(-30px, -80px) scale(0.95); }
  .blob-b { background: var(--c2); bottom: -8%; right: -10%; transform: translate(30px, -80px) scale(0.75); }

  /* settle into place once the tile has scrolled into view */
  :global(.is-visible) .blob { opacity: 0.85; transform: none; }

  /* glows spread apart on hover or press */
  :global(.is-visible) a:hover .blob-a,
  :global(.is-visible) a:active .blob-a { transform: translate(-10px, -12px) scale(1.08); }
  :global(.is-visible) a:hover .blob-b,
  :global(.is-visible) a:active .blob-b { transform: translate(14px, 12px) scale(1.08); }

  @media (prefers-reduced-motion: reduce) {
    .blob { opacity: 0.85; transform: none; transition: none; }
  }
</style>